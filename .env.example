# Local DEMO ONLY. Replace all credentials before use, even on a shared test host.
POSTGRES_PASSWORD=change-this-postgres-password
BANKBRIDGE_API_KEY=change-this-api-key
BANKBRIDGE_INTERNAL_TOKEN=change-this-internal-token
MQ_ADMIN_PASSWORD=change-this-mq-admin-password
MQ_APP_PASSWORD=change-this-mq-app-password
# MQ REST self-signed developer TLS; set true with a trusted CA in other environments.
MQ_TLS_VERIFY=false
# Optional Kafka / IBM Event Streams credentials:
# KAFKA_BOOTSTRAP_SERVERS=broker.example:9093
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_USERNAME=token
# KAFKA_PASSWORD=replace-me
# KAFKA_TOPIC=bankbridge.payments.v1
